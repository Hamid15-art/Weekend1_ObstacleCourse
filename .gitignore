# This .gitignore file should be placed at the root of your Unity project directory
# Standard Unity generated folders
Library/
Temp/
Obj/
Build/
Builds/
Logs/
UserSettings/

# MemoryCaptures can get large and overwhelm git
MemoryCaptures/

# Recordings can get large and overwhelm git
Recordings/

# Autogenerated VS/MonoDevelop/JetBrains files
ExportedObj/
.vs/
.idea/
.gradle/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity Generated Metal/Shader files
*.apk
*.unitypackage
*.aab
*.apk
*.unitypackage

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db